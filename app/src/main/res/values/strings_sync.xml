<resources>
    <!-- Sincronização (tela 26) -->
    <string name="sync_title">Sincronização</string>
    <string name="sync_last_done">Última sincronização concluída: %1$s</string>
    <string name="sync_last_never">Nenhuma sincronização foi concluída neste aparelho.</string>
    <plurals name="sync_pending_ops">
        <item quantity="one">%d operação local por enviar</item>
        <item quantity="other">%d operações locais por enviar</item>
    </plurals>
    <string name="sync_nothing_pending">Nenhuma operação por enviar neste aparelho</string>
    <string name="sync_nothing_pending_note">Nada pendente. O outro aparelho pode ter registros que ainda não chegaram.</string>
    <string name="sync_view_outdated">A visão do casal pode estar desatualizada.</string>
    <string name="sync_view_outdated_queue">A visão do casal pode estar desatualizada. O que está salvo aqui ainda não foi enviado.</string>
    <string name="sync_view_outdated_week">Passou uma semana desde o último sucesso. A visão do casal pode estar desatualizada; este aparelho não afirma estar em dia.</string>
    <string name="sync_count_note">A contagem é de operações, não de despesas: uma correção também conta.</string>
    <string name="sync_now">Sincronizar agora</string>
    <string name="sync_running_send">Enviando as operações locais…</string>
    <string name="sync_running_receive">Recebendo as alterações do casal…</string>
    <string name="sync_running_note">Registro e consulta continuam disponíveis enquanto sincroniza.</string>
    <string name="sync_done">Sincronizado. Só as operações reconhecidas foram marcadas como enviadas.</string>
    <string name="sync_done_conflict">Operações reconhecidas. O conflito continua aguardando sua escolha.</string>
    <string name="sync_unavailable_now">A última tentativa ficou sem conexão. Você pode tentar de novo: o reenvio usa a mesma identificação e não cria outro movimento.</string>
    <string name="sync_received_note">Reconhecidas pelo serviço. Dados que ainda estejam só no outro aparelho não aparecem aqui.</string>
    <string name="sync_offline_title">Sem conexão. A fila está preservada e a visão compartilhada pode estar incompleta.</string>
    <string name="sync_service_title">O serviço compartilhado está indisponível.</string>
    <string name="sync_service_body">Rede e sessão estão normais. Suas operações continuam salvas neste aparelho. Não há troca automática para plano pago. Depois que o serviço for retomado, tente de novo: o reenvio reconhece o que já foi aplicado.</string>
    <string name="sync_paused_title">O serviço do espaço está pausado.</string>
    <string name="sync_paused_body">O projeto no Supabase está pausado ou fora do ar. Suas operações continuam salvas neste aparelho. Não há troca automática para plano pago. Peça ao responsável pelo piloto para retomar o serviço e tente de novo.</string>
    <string name="sync_quota_title">O limite do plano gratuito foi atingido.</string>
    <string name="sync_quota_body">A fila foi preservada. Não migramos para plano pago nem ativamos cobrança sozinhos. Revise a solução com o responsável pelo piloto e, depois, tente de novo.</string>
    <string name="sync_session_title">Sua sessão expirou.</string>
    <string name="sync_session_body">Entre de novo para continuar enviando. A fila local e os registros foram preservados.</string>
    <string name="sync_session_action">Entrar de novo</string>
    <string name="sync_other_account_title">Estes dados pertencem a outra conta.</string>
    <string name="sync_other_account_body">Nada é enviado com a conta atual. Entre com a conta que fez estes registros para continuar o envio.</string>
    <string name="sync_failed_title">A sincronização não foi concluída.</string>
    <string name="sync_failed_body">Houve uma falha no serviço e a causa não foi identificada. Nada foi marcado como enviado. Tentar de novo reenvia com a mesma identificação, sem criar outro movimento.</string>
    <string name="sync_update_title">Atualize o aplicativo.</string>
    <string name="sync_update_body">O serviço usa uma versão do protocolo que este aplicativo não entende. A fila foi preservada e nada foi perdido; depois de atualizar, ela segue.</string>
    <string name="sync_not_member_title">Esta conta não participa do espaço.</string>
    <string name="sync_not_member_body">Nada foi enviado. Confira com quem criou o espaço se o convite foi aceito com esta conta.</string>
    <string name="sync_retry">Tentar de novo</string>
