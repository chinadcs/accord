<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Android 13+: pedida só pelo toque em "Permitir notificações" (passo dos Primeiros passos e tela 27). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Atualização pelo próprio app (ADR 0070): entrega o APK baixado ao instalador do Android, que pede a confirmação da pessoa. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Lista dos apps instalados com ícone de abertura, para a pessoa escolher quais notificações o Accord lê (ADR 0069); sem QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AccordApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Accord">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Compartilhar" de outros apps (accord-jcd9): texto vai para o campo do Chat; PDF, OFX e CSV vão para a leitura da importação. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-ofx" />
                <data android:mimeType="application/ofx" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".updates.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Leitura opcional de notificações de banco (ADR 0069): só funciona depois de a pessoa conceder o acesso nos ajustes do Android. -->
        <service
            android:name=".banknotifications.BankNotificationListener"
            android:exported="true"
            android:label="@string/bank_notifications_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
